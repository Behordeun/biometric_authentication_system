apiVersion: v1
kind: Secret
metadata:
  name: auth-secrets
type: Opaque
stringData:
  database-url: postgresql+asyncpg://user:password@postgres-service:5432/authdb  # pragma: allowlist secret
  redis-url: redis://:password@redis-service:6379
  secret-key: your-secret-key-here
  rp-id: your-domain.com
  origin: https://your-domain.com

# DO NOT commit this file with real values
# Create from template: cp secrets.yaml.example secrets.yaml
# Generate secrets:
#   openssl rand -base64 64 > secret-key.txt
#   openssl rand -base64 32 > db-password.txt
#   openssl rand -base64 32 > redis-password.txt
# Apply: kubectl apply -f secrets.yaml
# Add to .gitignore: secrets.yaml
