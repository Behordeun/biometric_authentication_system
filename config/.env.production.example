# Production Environment Variables
# DO NOT commit this file with real values
# Copy to .env.production and fill with actual values

DATABASE_URL=postgresql+asyncpg://user:password@prod-db-host:5432/authdb  # pragma: allowlist secret
REDIS_URL=redis://:password@prod-redis-host:6379
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RP_ID=auth.yourdomain.com
RP_NAME=Your Auth System
ORIGIN=https://yourdomain.com
ENVIRONMENT=production
