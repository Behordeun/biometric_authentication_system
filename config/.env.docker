# Docker Development Environment Variables
# Copy to .env for docker-compose: cp .env.docker .env

# Database
POSTGRES_USER=authuser
POSTGRES_PASSWORD=authpass  # pragma: allowlist secret
POSTGRES_DB=authdb

# Redis
REDIS_PASSWORD=redispass  # pragma: allowlist secret

# Backend
SECRET_KEY=dev-secret-key-change-in-production-use-generate-secrets-script  # pragma: allowlist secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# WebAuthn
RP_ID=localhost
RP_NAME=Hybrid Auth System
ORIGIN=http://localhost:3000

# Environment
ENVIRONMENT=development
