# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/authdb  # pragma: allowlist secret
POSTGRES_USER=authuser
POSTGRES_PASSWORD=
POSTGRES_DB=authdb

# Redis Configuration
REDIS_URL=redis://:password@localhost:6379
REDIS_PASSWORD=

# Security
SECRET_KEY=
ALGORITHM=HS256

# Token Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# WebAuthn Configuration
RP_ID=localhost
RP_NAME=Hybrid Auth System
ORIGIN=http://localhost:3000

# Environment
ENVIRONMENT=development

# Generate SECRET_KEY with: openssl rand -base64 64
# Generate POSTGRES_PASSWORD with: openssl rand -base64 32
# Generate REDIS_PASSWORD with: openssl rand -base64 32
