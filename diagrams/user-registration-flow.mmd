%%{init: { 'theme': 'default', 'themeVariables': { 'background': '#ffffff' } }}%%
flowchart TD
    Start([User Visits App]) --> CheckAccount{Has Account?}
    
    CheckAccount -->|No| EnterEmail[Enter Email & Username]
    CheckAccount -->|Yes| LoginFlow[Go to Login Flow]
    
    EnterEmail --> RequestOptions[Click Register with Biometric]
    RequestOptions --> FrontendReq[Frontend: POST /auth/register/options]
    
    FrontendReq --> BackendCheck{User Exists?}
    BackendCheck -->|Yes| Error1[Return Error: User Exists]
    BackendCheck -->|No| GenerateChallenge[Generate WebAuthn Challenge]
    
    GenerateChallenge --> StoreChallenge[Store Challenge in Redis<br/>TTL: 5 minutes]
    StoreChallenge --> ReturnOptions[Return Registration Options]
    
    ReturnOptions --> BrowserPrompt[Browser Shows Biometric Prompt]
    
    BrowserPrompt --> UserAuth{User Authenticates?}
    UserAuth -->|Cancel| Error2[Registration Cancelled]
    UserAuth -->|Success| DeviceCreatesKey[Device Creates Key Pair]
    
    DeviceCreatesKey --> SignChallenge[Device Signs Challenge]
    SignChallenge --> ReturnCredential[Return Public Key + Signature]
    
    ReturnCredential --> VerifyReq[Frontend: POST /auth/register/verify]
    VerifyReq --> GetChallenge[Retrieve Challenge from Redis]
    
    GetChallenge --> ValidChallenge{Challenge Valid?}
    ValidChallenge -->|No| Error3[Error: Challenge Expired]
    ValidChallenge -->|Yes| VerifySignature[Verify Signature]
    
    VerifySignature --> SigValid{Signature Valid?}
    SigValid -->|No| Error4[Error: Invalid Signature]
    SigValid -->|Yes| CreateUser[Create User Record]
    
    CreateUser --> StoreCredential[Store Public Key]
    StoreCredential --> GenerateTokens[Generate JWT Tokens]
    
    GenerateTokens --> CreateSession[Create Session]
    CreateSession --> ReturnTokens[Return Tokens]
    
    ReturnTokens --> Success([Registration Complete])
    
    Error1 --> End([End])
    Error2 --> End
    Error3 --> End
    Error4 --> End
    LoginFlow --> End

    style Start fill:#e1f5ff
    style Success fill:#c8e6c9
    style Error1 fill:#ffcdd2
    style Error2 fill:#ffcdd2
    style Error3 fill:#ffcdd2
    style Error4 fill:#ffcdd2
    style BrowserPrompt fill:#fff9c4
